{
  "name": "@cortexops/sdk",
  "version": "0.1.0",
  "description": "CortexOps TypeScript SDK: tracing, eval gates and CI regression checks for AI agents (Vercel AI SDK, OpenAI Agents, LangGraph.js, Mastra).",
  "license": "MIT",
  "author": "Ashish Verma",
  "homepage": "https://github.com/ashishodu2023/cortexops/tree/main/sdk-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishodu2023/cortexops.git",
    "directory": "sdk-js"
  },
  "bugs": {
    "url": "https://github.com/ashishodu2023/cortexops/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "observability",
    "tracing",
    "evaluation",
    "evals",
    "ci",
    "langgraph",
    "vercel-ai-sdk",
    "openai-agents",
    "mastra",
    "cortexops"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/golden-dataset.v1.json": "./schema/golden-dataset.v1.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "cortexops-js": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
